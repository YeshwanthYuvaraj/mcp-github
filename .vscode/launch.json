{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "GitHub MCP Server",
      "program": "${workspaceFolder}/build/index.js",
      "outFiles": [
        "${workspaceFolder}/build/**/*.js"
      ],
      "sourceMaps": true,
      "preLaunchTask": "tsc: build",
      "env": {
        "GITHUB_TOKEN": ""
      }
    }
  ]
}

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tsc: build",
      "type": "typescript",
      "tsconfig": "${workspaceFolder}/tsconfig.json",
      "problemMatcher": [
        "$tsc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm install",
      "type": "shell",
      "command": "npm",
      "args": [
        "install"
      ],
      "problemMatcher": []
    }
  ]
}
